{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maps.outlasttrialsstats.com/schemas/map.schema.json",
  "title": "Map-Manifest",
  "type": "object",
  "required": ["id", "meta", "trials"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/definitions/kebabId" },
    "meta": {
      "type": "object",
      "required": ["name", "authors"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/kebabId" },
          "name": { "type": "string", "minLength": 1 },
          "default": { "type": "boolean" }
        }
      }
    }
  },
  "definitions": {
    "kebabId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
