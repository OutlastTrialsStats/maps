{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maps.outlasttrialsstats.com/schemas/contributors.schema.json",
  "title": "Contributors",
  "type": "object",
  "required": ["contributors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "profileUrl", "maps"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "profileUrl": { "$ref": "#/definitions/profileUrl" },
          "avatar": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.webp$" },
          "maps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          }
        }
      }
    }
  },
  "definitions": {
    "profileUrl": {
      "type": "string",
      "pattern": "^https://outlasttrialsstats\\.com/[^\\s]*$"
    }
  }
}
