{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maps.outlasttrialsstats.com/schemas/zones.schema.json",
  "title": "Zonen-Bibliothek",
  "type": "object",
  "required": ["zones"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/zone" }
    }
  },
  "definitions": {
    "kebabId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "zone": {
      "type": "object",
      "required": ["id", "name", "fill", "walls"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/kebabId" },
        "name": { "type": "string", "minLength": 1 },
        "fill": { "$ref": "#/definitions/color" },
        "walls": { "$ref": "#/definitions/color" }
      }
    }
  }
}
