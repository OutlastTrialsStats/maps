{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maps.outlasttrialsstats.com/schemas/contributors.schema.json",
  "title": "Contributors",
  "type": "object",
  "required": ["contributors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "profileId", "profileUrl", "maps"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "profileId": { "$ref": "#/definitions/profileId" },
          "profileUrl": { "$ref": "#/definitions/profileUrl" },
          "maps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          }
        }
      }
    }
  },
  "definitions": {
    "profileId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "profileUrl": {
      "type": "string",
      "pattern": "^https://outlasttrialsstats\\.com/[^\\s]*$"
    }
  }
}
